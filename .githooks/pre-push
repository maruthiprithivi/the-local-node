#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
node scripts/check-public-repository.mjs
node website/ai-field-engineer/scripts/repository.mjs --check
command -v gitleaks >/dev/null 2>&1 || { echo 'Install gitleaks before pushing public learning materials.' >&2; exit 1; }
gitleaks git . --redact --no-banner --log-opts=--all
