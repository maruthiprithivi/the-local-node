# Copy to .env and fill in. .env is git-ignored — never commit keys.

# Which server scripts use when you don't pass --target (mock|ollama|llamacpp|mlx|fireworks|spark)
TARGET=mock

# --- Fireworks (lessons 01, 06b, 07, 08, 10, 13) ---
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxx
FIREWORKS_ACCOUNT_ID=your-account-id
# Look up current ids at https://app.fireworks.ai/models
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b

# --- local servers ---
OLLAMA_MODEL=llama3.1:8b
MLX_MODEL=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit

# --- DGX Spark (lesson 14) ---
SPARK_IP=your-spark-host
SPARK_MODEL=nvidia/Llama-3.1-8B-Instruct-FP8
