[22.426762, "o", "```bash\r\nread -r filePath=\"src/slugify.js\"\r\nread -r -d '' fileContent << 'EOF'\r\nfunction slugify(input) {\r\n  return input\r\n    .toString()\r\n    .toLowerCase()\r\n    .trim()\r\n    .replace(/\\\\s+/g, '-')\r\n    .replace(/[^a-z0-9-]/g, '')\r\n    .replace(/-+/g, '-')\r\n    .replace(/^-+|-+$/, 'n-a');\r\n}\r\n\r\nmodule.exports = slugify;\r\nEOF\r\n\r\nwrite -f \"$filePath\" -c \"$fileContent\"\r\nbash -c \"npm test\"\r\nbash -c \"git add $filePath\"\r\nbash -c 'git commit -m \"Implement slugify function\"'\r\necho \"<promise>COMPLETE</promise>\"\r\n```"]
