# Copy to .env, edit, then `set -a; . ./.env; set +a` before running the scripts. No secrets belong in this file.
KIT_STATE=./state                      # runner state: forge secrets (0600), canaries (0600), runs/
OPENSHELL_BIN=openshell                # sandbox CLI
IMAGE=dshsa-superagent:local           # built from docker/Dockerfile.superagent
SCORER_IMAGE=dshsa-scorer:local        # built from docker/Dockerfile.scorer
POLICY=docker/openshell-policy.example.yaml
SANDBOX_HOST_ALIAS=host.openshell.internal   # OpenShell's generic alias for the machine running the sandbox
MODEL_HOST_PORT=8000                   # your local OpenAI-compatible server (vLLM) on the host
MODEL_METRICS_URL=http://127.0.0.1:8000/metrics
MODEL_ID=your-local-model              # set this to the model id your endpoint serves
MODEL_CONTEXT=131072
MODEL_MAX_TOKENS=32768
FORGE_HOST_PORT=13300                  # forge/relay.py listens here on 127.0.0.1
# MEM_CGROUP=/sys/fs/cgroup/<your sandbox slice>   # optional
